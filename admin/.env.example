# Admin portal configuration.
# VITE_* values are baked into the bundle at build time and are PUBLIC.
# Never put a secret here.

# Admin API base. Leave as-is in development; Vite proxies /api to the server.
VITE_API_URL=/api

# Where the customer storefront lives, for "view site" links and previews.
VITE_SITE_URL=http://localhost:5173

# Cloudinary cloud name (public — used only to build delivery URLs).
VITE_CLOUDINARY_CLOUD_NAME=
