# ─────────────────────────────────────────────
# HUMOVARE API — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=5000

# Public URL of the storefront (used for CORS + emails + sitemap)
CLIENT_URL=http://localhost:5173
# Comma-separated list of additional allowed origins (optional)
CORS_ORIGINS=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/humovare?retryWrites=true&w=majority

# JWT — use long random strings (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Cookie domain for refresh token (leave blank for localhost)
COOKIE_DOMAIN=

# ── Admin portal ─────────────────────────────────────────────
# Public URL of the admin app (used for CORS; never use "*" in production)
ADMIN_URL=http://localhost:5174

# Admin tokens are signed with their own secrets and carry a `typ: admin`
# claim, so a customer token can never authenticate against an admin route.
# These MUST differ from the customer secrets above.
ADMIN_JWT_ACCESS_SECRET=replace-with-a-long-random-string
ADMIN_JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# First super admin, created by `npm run seed`. Change the password on first
# sign-in — the seeded account is flagged `mustChangePassword`.
SEED_SUPER_ADMIN_EMAIL=owner@humovare.in
SEED_SUPER_ADMIN_PASSWORD=Humovare@Admin2025

# ── Transactional email (Resend) ─────────────────────────────
# Server-side only. Never prefix these with VITE_ and never put the key in a
# front-end .env — anything with VITE_ is compiled into the public bundle.
#
# Use a *sending access* key restricted to the humovare.in domain
# (Resend → API Keys → Create → Permission: Sending access, Domain: humovare.in).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@humovare.in
RESEND_FROM_NAME=HUMOVARE
RESEND_REPLY_TO=support@humovare.in
# Shown in email footers; defaults to RESEND_REPLY_TO.
SUPPORT_EMAIL=support@humovare.in

# Where links in emails point (reset links, "View order"). Production must be
# https://humovare.in. Locally use the dev storefront so reset links work.
FRONTEND_URL=https://humovare.in

# Absolute https URL of the logo shown in emails. Must be reachable from the
# public internet — an inbox cannot load localhost. Defaults to
# ${FRONTEND_URL}/humovare-logo.png.
EMAIL_LOGO_URL=

# resend | preview | memory | disabled. Leave blank: it becomes `resend` when a
# key is set, `preview` in development without one (emails are written to
# server/.email-previews/), and `disabled` in production without one.
EMAIL_TRANSPORT=
# Development only: who may receive real mail. Exact addresses or *@domain,
# comma-separated; `*` means everyone. Others go to server/.email-previews/.
EMAIL_DEV_ALLOWLIST=*@resend.dev
# Background retries for transient failures (max 5 attempts per email).
EMAIL_RETRY_WORKER=true
EMAIL_RETRY_INTERVAL_MINUTES=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=humovare


# Commerce rules
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=79
CURRENCY=INR

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# ─── Sign in with Google ─────────────────────────────────────────
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console →
# APIs & Services → Credentials. Public — the storefront fetches it from
# GET /api/auth/providers. No client secret is needed. Leave blank to hide the
# Google button. See docs/DEPLOYMENT.md §2b.
GOOGLE_CLIENT_ID=

# ─── PhonePe (online payment) ────────────────────────────────────
# SERVER ONLY. Never put these in the storefront or any VITE_ variable.
# PhonePe Business Dashboard -> Developer Settings (Test mode for sandbox).
# PHONEPE_ENV must be "sandbox" or "production" - nothing switches by itself.
# Production needs its own, separate credentials.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Set when you create the webhook on the PhonePe dashboard (any strong values).
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Optional tuning
# PHONEPE_ATTEMPT_EXPIRY_SECONDS=900
# PAYMENT_WINDOW_MINUTES=30
# PAYMENT_RECONCILE_INTERVAL_SECONDS=120

# Admin activity (audit log) retention, in days. Older entries are
# permanently deleted automatically. 1-3650, default 3.
# AUDIT_LOG_RETENTION_DAYS=3

# ── Admin portal security ────────────────────────────────────────────────────
# All enforced on the server. Defaults shown; uncomment only to change them.
# ADMIN_LOGIN_MAX_ATTEMPTS=3        # wrong passwords in a row before sign-in locks
# ADMIN_LOGIN_LOCK_MINUTES=30       # how long the lock lasts (never permanent)
# ADMIN_IP_MAX_ATTEMPTS=3           # wrong passwords in a row (any email) before the lockout…
# ADMIN_IP_BLOCK_MINUTES=30         # …which lasts this long, refusing every admin request
# ADMIN_LOCKOUT_SCOPE=panel         # panel   = the WHOLE admin panel locks for everyone, every network (default)
#                                   # network = only the IP the attempts came from (needs TRUST_PROXY=true behind a proxy)
#                                   # Lift any lockout from the server shell: npm run security:unblock
# ADMIN_SESSION_IDLE_MINUTES=30     # signed out after this long with no activity
# ADMIN_SESSION_MAX_HOURS=12        # signed out after this long regardless
# ADMIN_REAUTH_MINUTES=10           # sensitive actions need the password re-entered after this
# ADMIN_RESET_TOKEN_MINUTES=30      # admin password-reset links expire after this
# Optional extra inbox for "admin sign-in locked" alerts (super admins always get them).
# SECURITY_ALERT_EMAIL=
# Where the admin app lives, for links in admin emails (defaults to FRONTEND_URL + /admin).
# ADMIN_PUBLIC_URL=https://humovare.in/admin
