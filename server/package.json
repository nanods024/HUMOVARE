{
  "name": "@humovare/server",
  "private": true,
  "version": "1.0.0",
  "description": "HUMOVARE REST API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:fresh": "node src/seed/seed.js --fresh",
    "seed:admin": "node scripts/seed-admin.mjs",
    "db:indexes": "node scripts/sync-indexes.mjs",
    "security:unblock": "node scripts/unblock-admin-ips.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:admin": "node scripts/admin-smoke-test.mjs",
    "test:email": "node scripts/email-smoke-test.mjs",
    "email:check": "node scripts/email-live-check.mjs",
    "test": "npm run test:smoke && npm run test:admin && npm run test:email && npm run test:payments",
    "dev:standalone": "node scripts/dev-standalone.mjs",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "test:payments": "node scripts/payment-test.mjs",
    "payments:check": "node scripts/phonepe-sandbox-check.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "resend": "^6.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "mongodb-memory-server": "^11.2.0"
  }
}
