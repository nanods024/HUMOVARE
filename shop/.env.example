# Base URL of the HUMOVARE API.
# Leave as-is for local development; Vite proxies /api to the server.
VITE_API_URL=http://localhost:5000/api

# Public site URL — used for canonical tags, Open Graph and the sitemap.
VITE_SITE_URL=http://localhost:5173

# Cloudinary cloud name (public; used only to build delivery URLs client-side).
# Must match CLOUDINARY_CLOUD_NAME in server/.env. Leaving it blank still works,
# but every product photo is then served at its original size and format — a
# 2MB PNG instead of a 90KB WebP — so set it.
VITE_CLOUDINARY_CLOUD_NAME=
