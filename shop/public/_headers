# Security headers for the admin portal (served from /admin by the static host).
# The API sets its own headers; these cover the admin HTML and its assets.
/admin/*
  # Never shown inside another site's frame (clickjacking).
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  # Admin screens must not be kept by the browser or a proxy after sign-out.
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
